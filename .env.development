# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_VERSION=v1

# Feature Flags
VITE_ENABLE_AI_TOOLS=true
VITE_ENABLE_COMMUNITY=true
VITE_ENABLE_ANALYTICS=false

# External Services
VITE_OPENAI_API_ENDPOINT=https://api.openai.com/v1
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Application Settings
VITE_APP_NAME=AI for Students
VITE_APP_DESCRIPTION=Empowering students with AI tools and resources
VITE_SUPPORT_EMAIL=support@aiforstudents.com

# Authentication
VITE_AUTH_DOMAIN=your-auth-domain.region.auth.com
VITE_AUTH_CLIENT_ID=your-client-id
VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback 